# Copy to .env and fill in what you have. All are optional except DEFAULT_MODEL,
# which controls what the app uses when nothing else is selected yet.

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (OpenAI, OpenRouter, local Ollama, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# provider:model, e.g. anthropic:claude-sonnet-5, openai:gpt-4o, mock:mock
DEFAULT_MODEL=mock:mock

# Optional. Default is anchored to AnimaBackend/data/animabackend.db regardless
# of the directory uvicorn is launched from — only override if you must.
# DATABASE_URL=sqlite:///./data/animabackend.db
